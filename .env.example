# Copy to .env.local and fill in. Never commit .env.local. Never put real values in this file.

# --- NEAR AI Cloud -----------------------------------------------------------------------------
# API key (https://cloud.near.ai, or the free credits key from https://nearbuilders.org/dashboard).
# Without it Morrow still runs: upload, keyword search, the viewer and live attestation checks work,
# but meaning search and Ask are disabled. Morrow never falls back to another provider.
NEARAI_API_KEY=

# Optional overrides (defaults shown). Models must be NEAR-operated TEE models with attestation.
# NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# NEARAI_CHAT_MODEL=z-ai/glm-5.3-flash
# NEARAI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# NEARAI_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# MORROW_ATTESTATION_TTL_MINUTES=10

# --- Storage -----------------------------------------------------------------------------------
# Where the SQLite database, uploaded files and receipts live.
# MORROW_DATA_DIR=./data

# Encrypt stored original files and receipts (AES-256-GCM, per-user derived keys).
# Generate with:  openssl rand -base64 32
# IF THIS KEY IS LOST, ENCRYPTED FILES CANNOT BE RECOVERED. Keep a copy away from the server and
# its backups. The database (extracted text, passages, embeddings, answers) is NOT encrypted by this.
# After setting it, run:  npm run backup && npm run migrate:storage -- --apply
# MORROW_ENCRYPTION_KEY=

# MORROW_MAX_UPLOAD_MB=20
# MORROW_MAX_PDF_PAGES=800
# MORROW_MAX_DOCUMENTS=2000

# --- AI budgets (per UTC day; 0 switches the feature off) --------------------------------------
# MORROW_USER_DAILY_QUESTIONS=50
# MORROW_USER_DAILY_TOKENS=400000
# MORROW_USER_DAILY_EMBED_PASSAGES=3000
# MORROW_APP_DAILY_QUESTIONS=1000
# MORROW_APP_DAILY_TOKENS=5000000

# --- Accounts and sessions ---------------------------------------------------------------------
# Set to false on a shared host once your accounts exist.
# MORROW_ALLOW_SIGNUP=true
# MORROW_SESSION_IDLE_DAYS=7

# --- Deployment behind a reverse proxy ---------------------------------------------------------
# Number of proxies YOU run in front of Morrow. 0 = ignore X-Forwarded-* entirely (correct for
# localhost and for direct exposure). Set to 1 behind one proxy that sets X-Forwarded-For/-Host/-Proto.
# Setting this without such a proxy lets clients forge their address.
# MORROW_TRUSTED_PROXY_HOPS=0
# Force the Secure flag on the session cookie (set when Morrow is served over HTTPS).
# MORROW_SECURE_COOKIES=false

# --- Email (password reset and address verification) -------------------------------------------
# none    (default) reset and verification are switched off, and the interface says so
# log     development only: prints emails, including one-time links, to the server log
# resend  sends through https://resend.com (needs RESEND_API_KEY and a verified sender address)
# MORROW_MAIL_TRANSPORT=none
# RESEND_API_KEY=
# MORROW_MAIL_FROM=Morrow <no-reply@your-domain.example>
# Links in emails are built from this, never from the incoming request.
# MORROW_PUBLIC_URL=http://localhost:3000
# With email on, new accounts must confirm their address. Set false to keep reset without verification.
# MORROW_REQUIRE_EMAIL_VERIFICATION=true
