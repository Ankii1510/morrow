# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Morrow: user data and secrets never go in the repository
/data/
.env
.env.local
morrow-receipt-*.json
morrow-export.json
submission-payload.json
!.env.example

# Local safety backups (contain user data and secrets)
/.backups/

# Defence in depth: never commit databases, logs, key material or migration leftovers,
# wherever they are (for example a custom MORROW_DATA_DIR inside the project).
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db
*.log
*.key
*.migrating
/morrow-data-*/

# Locally recorded demo videos (uploaded to X, not kept in the repository)
/demo-video/
